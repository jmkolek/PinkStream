<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground: the sparkles tile icon (ic_deck_sparkles) in the rose tile's icon
  colour. Adaptive icons are 108 x 108 and only the middle 66 dp circle is always shown,
  so the 24-unit icon is scaled 2.4x and centred on its visual middle (13.25, 11.9).
  Also used as the monochrome layer (themed icons): the system only uses its shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="22.2"
        android:translateY="25.44">
        <path
            android:pathData="M12 3.5l1.7 4.8 4.8 1.7-4.8 1.7L12 16.5l-1.7-4.8L5.5 10l4.8-1.7z"
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"
            android:strokeColor="@color/launcher_foreground"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
